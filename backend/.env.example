# ========================================================
# AI-Driven Wildfire Risk Assessment Platform (.env.example)
# All keys must be provided via environment variables.
# ========================================================

# Application Environment (development | staging | production)
ENV=development
LOG_LEVEL=INFO

# PostgreSQL + PostGIS (asyncpg required for SQLAlchemy async)
# Example: postgresql+asyncpg://postgres.<project-ref>:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Internal Background Job Execution Token (Header: X-Job-Token)
JOB_TOKEN=

# NASA FIRMS API (Area API Key)
FIRMS_MAP_KEY=
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT

# CPCB / data.gov.in Integration (Optional)
DATAGOVIN_API_KEY=
ENABLE_CPCB=false

# Background Scheduler (APScheduler in-process)
ENABLE_SCHEDULER=true

# Country Configuration Defaults
DEFAULT_COUNTRY=IN

# ML Model Runtime
MODEL_DIR=models
ACTIVE_WILDFIRE_MODEL=wildfire_xgb_v2
ACTIVE_AQI_MODEL=aqi_prophet_v1

# Open-Meteo Base URLs (overridable for testing or caching proxies)
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Retention Configuration
RETENTION_DAYS=400
